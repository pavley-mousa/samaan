# Copy this file to .env locally. Never commit .env or replace these placeholders with real secrets in GitHub.
# Local development
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
API_PROXY_TARGET=http://localhost:4000

# Supabase PostgreSQL: get the full Session Pooler URI from Supabase > Connect.
# Never guess the username or password; keep this value only in local .env and hosting Secret settings.
DATABASE_URL=

# Server-side JWT signing secret; generate a fresh random value with at least 32 characters.
JWT_SECRET=

# Optional local admin bootstrap values; do not commit real credentials.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# SMTP is required for real email verification. Leave blank only for local-only development.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional local storage configuration, if/when storage upload integration is enabled.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Same Google OAuth Web Client ID in API and storefront; this is a public client identifier, not a client secret.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
